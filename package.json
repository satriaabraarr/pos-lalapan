{
  "name": "pos-lalapan",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Kasir Warung Lalapan - POS Lalapan",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "desktop": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "desktop:build": "electron-builder --config electron/builder.json"
  },
  "prisma": { "seed": "node prisma/seed.mjs" },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "wait-on": "^8.0.1"
  }
}
